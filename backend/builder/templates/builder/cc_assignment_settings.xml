<?xml version="1.0" encoding="UTF-8"?>
<assignment identifier="{{ ident }}" {{ ns|safe }}>
  <title>{{ title }}</title>
  <due_at/>
  <lock_at/>
  <unlock_at/>
  <module_locked>false</module_locked>
  <workflow_state>unpublished</workflow_state>
  <assignment_overrides/>
