# Corpus files belong only in corpus/, which has its own allowlist (corpus/.gitignore, written by
# tools/import_corpus.py). Everywhere else, keep stray downloads such as an unzipped Drive folder
# out of commits.
*.pdf
*.doc
*.docx
*.epub
*.zip
*.pptx
*.xlsx
# Justin's unzipped Drive download (includes commercial books and the catalog workbook)
/Readings/

# Python and tool leftovers
__pycache__/
*.pyc
*.json.tmp

# --- App build output and local environments (restored alongside the corpus rules above)
**/.venv/
backend/db.sqlite3
backend/staticfiles/
# Reading full text fetched by `manage.py warm_content` (publisher content, rebuilt on demand)
backend/content_cache/
frontend/node_modules/
frontend/dist/
.claude/
.env
*.log

# --- Private research files: they describe what's in Justin's Google Drive
research/drive_inventory.json
research/pdf_mirror.json
research/catalog/
docs/proposal.md
